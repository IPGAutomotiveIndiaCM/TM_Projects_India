DrivMan.Man.0.LongStep.0.Cmds:
	# Constant velocity of pedestrian
	Eval v_ped = ($v_vru=8)/3.6
	# Constant velocity of vehicle (fits to IPGDriver maneuver speed)
	Eval v_vut = ($v_vut=35/3.6)
	# Impact position in percentage of vehicle width
	Eval impact_pos = ($impact_pos=0.5)
	# Initial lateral offset of pedestrian (fits to value in the Traffic dialog)
	Eval y0_ped = 4.0
	# Pedestrian length (fits to value in the Traffic dialog)
	Eval ped_length = 0.33
	# Pedestrian width (fits to value in the Traffic dialog)
	Eval ped_width = 0.55
	# Vehicle width (fits to DemoCar)
	Eval veh_width = 1.8
	# Distance for acceleration of pedestrian to reach constant velocity
	Eval d_ped_acc = 0.5
	# Constant acceleration of pedestrian based on constant end velocity v_ped and distance d_ped_acc
	Eval a_ped	= v_ped**2/(2*d_ped_acc)
	# Time for acceleration of pedestrian based on constant end velocity v_ped and distance d_ped_acc
	Eval Qu::t_ped_acc = 2*d_ped_acc/v_ped
	# Distance for pedestrian between point where v_ped is reached and impact position impact_pos (middle of pedestrian box)
	# Note: 4.5 = abs(y0_ped) + half track width - d_ped_acc
	Eval Qu::d_ped_run = 4.5-ped_length/2+veh_width*(impact_pos - 1/2)
	# Time to reach d_ped_run with velocity v_ped starting from d_ped_acc
	Eval t_ped_run = d_ped_run/v_ped
	# Trigger distance between pedestrian and vehicle. Assuming the vehicle move with speed v_vut it will hit the pedestrian at impact_pos.
	Eval d_veh_trigger = (t_ped_acc+t_ped_run)*v_vut
	# Trigger to set t0 when distance between vehicle and pedestrian fall below d_veh_trigger
	Eval first() ? t0 = 0
	Eval first( ((Traffic.P00.sRoad-ped_width/2)-(Vhcl.sRoad+4.28-3.40)) < d_veh_trigger) ? t0 = DM.Long.StepTime
	# Accelerate pedestrian with calculated a_ped using a_ped	= v_ped**2/(2*d_ped_acc) and 1/2*a_ped*t**2
	Eval ((t0>0) && (DM.Long.StepTime < t0 + t_ped_acc))  ? Traffic.P00.ty = y0_ped - v_ped**2/(4*d_ped_acc)*(DM.Long.StepTime-t0)**2
	# Move pedestrian with constant velocity v_ped
	Eval ((t0>0) && (DM.Long.StepTime >= t0 + t_ped_acc)) ? Traffic.P00.ty = y0_ped - d_ped_acc - v_ped*(DM.Long.StepTime-t0-t_ped_acc)
